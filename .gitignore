# Entornos virtuales de Python (Windows y Linux)
.venv/
venv/
env/
ENV/

# Bytecode y cachés de Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.eggs/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Secretos locales
.env

# Archivos de sistema
.DS_Store
Thumbs.db
Desktop.ini

# Bases SQLite y sus archivos auxiliares (se regeneran con el pipeline)
*.db
*.db-wal
*.db-shm
*.sqlite

# Datos intermedios y procesados (se regeneran; .gitkeep se versiona)
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Modelos, MLflow y reportes generados (el pipeline los vuelve a crear)
models/*
!models/.gitkeep
!models/referencia.json
models/modelo_mlflow/
models/mlflow.db
models/mlartifacts/
mlflow.db
mlruns/
mlartifacts/
reports/*
!reports/.gitkeep
